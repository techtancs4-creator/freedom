# Copy this file to .env and set strong unique values.
# Flask does not load .env automatically: set these in your hosting panel or terminal.

# Long random text. If left unset, a random key is generated once and saved in .secret_key
SECRET_KEY=replace-with-a-long-random-secret

# The admin account is created/repaired from these on every start
ADMIN_USERNAME=your-admin-name
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-16-characters
ADMIN_EMAIL=you@example.com

SERVER_IP=free2.vektalnodes.in:26843
SERVER_VERSION=Java 1.21.x
DISCORD_URL=https://discord.gg/gkdRBbfHy

# Set to 1 only behind HTTPS in production
COOKIE_SECURE=0

# Set to 1 behind a reverse proxy / hosting platform so rate limits see real visitor IPs
TRUST_PROXY=0

# FLASK_DEBUG=0
